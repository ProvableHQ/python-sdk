    output r15 as dynamic.record;
    output r18 as field.public;
    output r19 as shield_swap.aleo/PositionNFT.record;
    output r24 as dynamic.record;
    output r28 as dynamic.record;
    output r30 as dynamic.record;
    output r34 as dynamic.record;
    output r22 as shield_swap.aleo/MintComplianceRecord.record;
    output r36 as shield_swap_rebalance_router.aleo/rebalance_plain_plain_one.future;

