import shield_swap.aleo;
import shield_swap_freezelist.aleo;
import shield_swap_multisig_core.aleo;

program shield_swap_rebalance_router.aleo;

struct U256__8JquwLopp8:
    hi as u128;
    lo as u128;

struct MerkleProof:
    siblings as [field; 16u32];
    leaf_index as u32;

struct ChecksumEdition:
    checksum as [u8; 32u32];
    edition as u16;

struct RebalanceRequest:
    old_liquidity as u128;
    recovered0 as u128;
    recovered1 as u128;
    funded0 as u128;
    funded1 as u128;
    refund0 as u128;
    refund1 as u128;
    liquidity_target as u128;
    mint as shield_swap.aleo/MintPositionRequest;
    deadline as u32;

closure as_core_request:
    input r0 as RebalanceRequest;
    cast r0.old_liquidity r0.recovered0 r0.recovered1 r0.funded0 r0.funded1 r0.refund0 r0.refund1 r0.liquidity_target r0.mint r0.deadline into r1 as shield_swap.aleo/CoreRebalanceRequest;
    output r1 as shield_swap.aleo/CoreRebalanceRequest;

function rebalance_plain_plain_none:
    input r0 as shield_swap.aleo/PositionNFT.record;
    input r1 as field.private;
    input r2 as RebalanceRequest.public;
    input r3 as shield_swap.aleo/RebalanceAssets.public;
    input r4 as [shield_swap.aleo/MerkleProof; 2u32].private;
    input r5 as [shield_swap.aleo/MerkleProof; 2u32].private;
    assert.eq r2.funded0 0u128;
    assert.eq r2.funded1 0u128;
    call as_core_request r2 into r6;
    call shield_swap.aleo/rebalance_position r0 r1 r6 r3 r4 r5 into r7 r8 r9 r10 r11 r12;
    call.dynamic r3.token0.token_id 'aleo' 'transfer_private_to_public' with r9 shield_swap_rebalance_router.aleo r2.refund0 (as dynamic.record address.public u128.public) into r13 r14 (as dynamic.record dynamic.future);
    is.eq r2.refund0 0u128 into r15;
    ternary r15 self.signer r0.withdrawal into r16;
    call.dynamic r3.token0.token_id 'aleo' 'transfer_public_to_private' with r16 r2.refund0 (as address.private u128.public) into r17 r18 (as dynamic.record dynamic.future);
    call.dynamic r3.token1.token_id 'aleo' 'transfer_private_to_public' with r10 shield_swap_rebalance_router.aleo r2.refund1 (as dynamic.record address.public u128.public) into r19 r20 (as dynamic.record dynamic.future);
    is.eq r2.refund1 0u128 into r21;
    ternary r21 self.signer r0.withdrawal into r22;
    call.dynamic r3.token1.token_id 'aleo' 'transfer_public_to_private' with r22 r2.refund1 (as address.private u128.public) into r23 r24 (as dynamic.record dynamic.future);
    async rebalance_plain_plain_none r3 r12 r14 r18 r20 r24 into r25;
    output r7 as field.public;
    output r8 as shield_swap.aleo/PositionNFT.record;
    output r13 as dynamic.record;
    output r17 as dynamic.record;
    output r19 as dynamic.record;
    output r23 as dynamic.record;
    output r11 as shield_swap.aleo/MintComplianceRecord.record;
    output r25 as shield_swap_rebalance_router.aleo/rebalance_plain_plain_none.future;

finalize rebalance_plain_plain_none:
    input r0 as shield_swap.aleo/RebalanceAssets.public;
    input r1 as shield_swap.aleo/rebalance_position.future;
    input r2 as dynamic.future;
    input r3 as dynamic.future;
    input r4 as dynamic.future;
    input r5 as dynamic.future;
    contains shield_swap.aleo/from_wrapper_token_id[r0.token0.token_id] into r6;
    not r6 into r7;
    assert.eq r7 true;
    contains shield_swap.aleo/from_wrapper_token_id[r0.token1.token_id] into r8;
    not r8 into r9;
    assert.eq r9 true;
    await r1;
    await r2;
    await r3;
    await r4;
    await r5;

